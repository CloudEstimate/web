---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildCanonical, buildPageJsonLd } from "@/lib/seo";
import { precomputedAI } from "@/lib/site";

const title = "Methodology | CloudEstimate";
const description =
  "How CloudEstimate uses the Precomputed AI design pattern through reference architecture artifacts, pricing snapshots, and dated estimates.";
const jsonLd = buildPageJsonLd({
  type: "TechArticle",
  title: "CloudEstimate methodology",
  description,
  canonical: buildCanonical("/methodology")
});
---

<BaseLayout title={title} description={description} canonical={buildCanonical("/methodology")} jsonLd={jsonLd}>
  <section class="page-shell-narrow prose-page py-10 lg:py-14">
    <h1>Methodology</h1>

    <p>
      Each estimate starts with a published vendor or open-source reference architecture. A size tier maps to a concrete set of components, those components are matched to current-generation cloud instance families, and cached commercial pricing snapshots provide the monthly and annual cost.
    </p>

    <h2>Precomputed AI design pattern</h2>
    <p>
      CloudEstimate is a worked example of the <a href={precomputedAI.url}>Precomputed AI</a> design pattern
      for artifact-first LLM systems. Reference architectures, shape mappings, pricing snapshots, and
      validated explanation caches are versioned artifacts produced ahead of time and served without
      live model inference. Machine-readable artifacts are also published statically at
      {" "}<a href="/api/v1/catalog.json"><code>/api/v1/catalog.json</code></a> and <a href="/llms.txt"><code>/llms.txt</code></a>.
    </p>
    <p>
      Methodology citation: <cite>{precomputedAI.citation}</cite> <a href={precomputedAI.citationUrl}>{precomputedAI.citationUrl}</a>.
    </p>

    <h2>What is modelled</h2>
    <ul>
      <li>Compute-optimized (1:2), general-purpose (1:4), memory-optimized (1:8), and GPU inference VM shapes mapped across Google Cloud (N4, G2), AWS (C7i, M7i, R7i, G4dn), and Azure (Dlsv6, Dsv6, Esv6, NCas_T4_v3)</li>
      <li>Optional Linux Arm64 compute comparisons across Google Cloud Axion (C4A), AWS Graviton (C7g, M8g, R8g), and Azure Cobalt 100 (Dpldsv6, Dpsv6, Epsv6) for compatible workloads</li>
      <li>Block storage (NVMe/Hyperdisk, SSD, HDD), native cloud object storage buckets, and managed cloud load balancers</li>
      <li>12 commercial regions across North America, Europe, and Asia-Pacific across On-Demand, 1-year, and 3-year commitment terms</li>
      <li>High-availability failover nodes when the baseline topology is not already replicated, plus multi-cloud Terraform / OpenTofu starter baselines</li>
    </ul>

    <h2>What is not modelled</h2>
    <ul>
      <li>Vendor software licensing and commercial support subscriptions</li>
      <li>Network egress, cross-AZ replication bandwidth, and multi-region disaster recovery</li>
      <li>Compliance controls, snapshot backup retention, and external monitoring platforms</li>
      <li>Managed SaaS equivalents, enterprise private-pricing agreements, and hybrid-use benefits</li>
    </ul>

    <h2>Refresh cadence</h2>
    <p>
      Pricing and explanation snapshots refresh daily via scheduled CI workflows, stamping prompt hashes so changed hardware or pricing triggers immediate cache regeneration. Reference architectures refresh when vendors publish materially updated sizing guidance.
    </p>

    <h2>Reporting errors</h2>
    <p>
      If an estimate looks wrong, open an issue with the estimate URL, cloud, region, and the upstream documentation or pricing feed that disagrees. Contributions for new ISVs follow the YAML schema and validation gates in the repository.
    </p>
  </section>
</BaseLayout>
