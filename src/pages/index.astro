---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IsvCard from "@/components/IsvCard.astro";
import { buildCanonical, buildPageJsonLd } from "@/lib/seo";
import { categoryLabels, precomputedAI, siteConfig } from "@/lib/site";

const isvs = (await getCollection("isvs")).sort((left, right) =>
  left.data.name.localeCompare(right.data.name)
);
const categories = Array.from(new Set(isvs.map((isv) => isv.data.category))).sort((left, right) =>
  (categoryLabels[left] ?? left).localeCompare(categoryLabels[right] ?? right)
);
const title = "Self-managed workload sizing across Google Cloud, AWS, and Azure | CloudEstimate";
const description =
  "A worked example of the Precomputed AI design pattern for reference-architecture-based sizing across Google Cloud, AWS, and Azure.";
const jsonLd = buildPageJsonLd({
  type: "WebSite",
  title: siteConfig.name,
  description,
  canonical: buildCanonical("/"),
  image: new URL("/og.png", siteConfig.url).toString()
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={buildCanonical("/")}
  jsonLd={jsonLd}
>
  <section class="page-shell py-12 lg:py-16">
    <div class="home-hero">
      <h1>Size self-managed workloads across Google Cloud, AWS, and Azure.</h1>
      <p>
        Reference-architecture-based sizing and monthly cost estimates across {isvs.length} workloads and 12 global regions, served from precomputed artifacts.
      </p>
    </div>

    <div class="mt-10 space-y-4">
      <div class="home-filter-grid">
        <div>
          <label class="field-label" for="isv-filter">Filter ISVs</label>
          <input
            class="w-full rounded-[6px] border px-3 py-2 text-sm"
            style="border-color: var(--color-border);"
            id="isv-filter"
            type="search"
            placeholder="Filter by ISV, vendor, or category"
          />
        </div>
        <p class="home-filter-note">No signup, no guessing.</p>
      </div>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button class="button-chip" data-category-chip="all" data-active="true" type="button">
          All ({isvs.length})
        </button>
        {categories.map((category) => (
          <button class="button-chip" data-category-chip={category} data-active="false" type="button">
            {categoryLabels[category] ?? category}
          </button>
        ))}
      </div>
    </div>

    <div class="home-results-divider" aria-live="polite">
      <div class="home-results-meta">
        <span class="home-results-label">Available workloads</span>
        <span class="home-results-count" id="isv-count">{isvs.length} shown</span>
      </div>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="isv-grid">
      {isvs.map((isv) => (
        <div
          data-filter-card={`${isv.data.name} ${isv.data.vendor} ${isv.data.slug} ${categoryLabels[isv.data.category] ?? isv.data.category}`.toLowerCase()}
          data-filter-category={isv.data.category}
        >
          <IsvCard isv={isv} />
        </div>
      ))}
    </div>

    <div class="home-insights">
      <div class="grid gap-8 lg:grid-cols-3">
        <section class="insight-card">
          <p class="insight-card-kicker">How it works</p>
          <h2>Reference architecture in, estimate out.</h2>
          <p>
            Published vendor reference architectures are mapped to cloud instance shapes, then priced against cached regional snapshots. This follows the <a href={precomputedAI.url}>Precomputed AI</a> design pattern: versioned artifacts serve the common path instantly.
          </p>
        </section>
        <section class="insight-card">
          <p class="insight-card-kicker">What&apos;s not modelled</p>
          <h2>Useful constraints, stated plainly.</h2>
          <ul>
            <li>Vendor licensing and support</li>
            <li>Network egress and backups</li>
            <li>Compliance controls and DR topologies</li>
          </ul>
        </section>
        <section class="insight-card">
          <p class="insight-card-kicker">Who built this</p>
          <h2>Built as a focused, opinionated utility.</h2>
          <p>
            CloudEstimate is a personal project by Regnard Raquedan and a worked example of the <a href={precomputedAI.url}>Precomputed AI</a> design pattern. The short version and citations are on <a href="/about">About</a>.
          </p>
        </section>
      </div>
    </div>
  </section>

  <script is:inline>
    const input = document.getElementById("isv-filter");
    const cards = Array.from(document.querySelectorAll("[data-filter-card]"));
    const chips = Array.from(document.querySelectorAll("[data-category-chip]"));
    const count = document.getElementById("isv-count");
    let activeCategory = "all";

    function applyFilter() {
      const query = (input?.value || "").trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || card.dataset.filterCard.includes(query);
        const matchesCategory = activeCategory === "all" || card.dataset.filterCategory === activeCategory;
        const matches = matchesQuery && matchesCategory;
        card.style.display = matches ? "" : "none";
        if (matches) {
          visible += 1;
        }
      });

      if (count) {
        count.textContent = `${visible} shown`;
      }
    }

    input?.addEventListener("input", applyFilter);
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeCategory = chip.dataset.categoryChip || "all";
        chips.forEach((candidate) => {
          candidate.dataset.active = String(candidate === chip);
        });
        applyFilter();
      });
    });
  </script>
</BaseLayout>
