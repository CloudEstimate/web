---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildCanonical, buildPageJsonLd } from "@/lib/seo";

const isvs = (await getCollection("isvs")).sort((left, right) =>
  left.data.name.localeCompare(right.data.name)
);
const title = "Acknowledgements | CloudEstimate";
const description = "Reference architectures, pricing sources, and open tools that make CloudEstimate possible.";
const jsonLd = buildPageJsonLd({
  title: "CloudEstimate acknowledgements",
  description,
  canonical: buildCanonical("/acknowledgements")
});
---

<BaseLayout title={title} description={description} canonical={buildCanonical("/acknowledgements")} jsonLd={jsonLd}>
  <section class="page-shell-narrow prose-page py-10 lg:py-14">
    <h1>Acknowledgements</h1>

    <p>
      CloudEstimate encodes published vendor and open-source project sizing guidance across {isvs.length} workloads, combined with commercial cloud pricing feeds and open-source build tooling.
    </p>

    <h2>Reference architectures ({isvs.length})</h2>
    <ul>
      {isvs.map((isv) => (
        <li>
          <a href={isv.data.ref_arch.source_url}>{isv.data.name}</a> — {isv.data.vendor} ({isv.data.ref_arch.version})
        </li>
      ))}
    </ul>

    <h2>Cloud pricing feeds and tooling</h2>
    <ul>
      <li><a href="https://cloud.google.com/billing/docs/reference/rest/v1/services.skus/list">Google Cloud Billing Catalog API</a></li>
      <li><a href="https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/price-changes.html">AWS Price List Bulk API</a></li>
      <li><a href="https://learn.microsoft.com/rest/api/cost-management/retail-prices/azure-retail-prices">Azure Retail Prices API</a></li>
      <li><a href="https://astro.build/">Astro</a>, <a href="https://tailwindcss.com/">Tailwind CSS</a>, <a href="https://vitest.dev/">Vitest</a>, and <a href="https://github.com/thx/resvg-js">Resvg</a></li>
    </ul>

    <p>This tool is possible because these teams publish their engineering documentation and pricing openly. Thank you.</p>
  </section>
</BaseLayout>
